# Copy this file to .env and fill in your values. Never commit .env.

# AEMET OpenData API key (free): https://opendata.aemet.es/centrodedescargas/altaUsuario
AEMET_API_KEY=

# Local landing zone for raw files
LANDING_DIR=data/landing

# Databricks (only needed for `energy-ingest upload`)
DATABRICKS_HOST=https://<your-workspace>.cloud.databricks.com
DATABRICKS_TOKEN=
# Unity Catalog volume that receives raw files
DATABRICKS_VOLUME_PATH=/Volumes/energy/raw/landing
